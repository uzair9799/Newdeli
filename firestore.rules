rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAppAdmin() {
      return isSignedIn() && request.auth.token.email == 'uzair9799@gmail.com';
    }

    // Registered Users Collection
    match /registered_users/{userDoc} {
      allow get: if isSignedIn() && (
        isAppAdmin() || 
        request.auth.token.email == resource.data.email || 
        request.auth.token.email == userDoc
      );
      allow list: if isAppAdmin();
      
      allow create: if isSignedIn() && (
        isAppAdmin() || 
        (request.auth.token.email == request.resource.data.email)
      );
      allow update: if isSignedIn() && (
        isAppAdmin() || 
        (request.auth.token.email == resource.data.email &&
         request.resource.data.isEnabled == resource.data.isEnabled &&
         request.resource.data.role == resource.data.role)
      );
      allow delete: if isAppAdmin();
    }

    // Users Collection (Allow admin to access any previous/legacy registered user profiles)
    match /users/{userDoc} {
      allow read, write: if isAppAdmin();
      allow get: if isSignedIn() && (
        request.auth.uid == userDoc || 
        request.auth.token.email == userDoc ||
        request.auth.token.email == resource.data.email
      );
      allow create, update: if isSignedIn() && (
        isAppAdmin() || 
        request.auth.uid == userDoc ||
        request.auth.token.email == request.resource.data.email
      );
    }

    // Shipments Collection
    match /shipments/{shipmentId} {
      // Anyone can look up a specific shipment if they have the ID (Tracking)
      allow get: if true;
      
      // Only authenticated admins can list all shipments or create/edit/delete
      // In a real app, you'd check for a specific admin email or role
      allow list, write: if isSignedIn() && isEmailVerified();
    }
  }
}
